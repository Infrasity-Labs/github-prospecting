{
  "info": {
    "name": "GitHub Agent-Memory/Agent Repo Search",
    "description": "Runs the same GitHub search queries as config/queries.json directly against the GitHub REST Search API. Each request returns raw JSON (items[] = matching repos) with no filtering applied. Set the collection variable `github_token` to a GitHub personal access token to raise your rate limit (5000/hr vs 60/hr unauthenticated).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "github_token", "value": "", "type": "string" },
    { "key": "per_page", "value": "100", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{github_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "topic:agent-memory",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/vnd.github+json" }],
        "url": {
          "raw": "https://api.github.com/search/repositories?q=topic%3Aagent-memory&sort=stars&order=desc&per_page={{per_page}}",
          "protocol": "https",
          "host": ["api", "github", "com"],
          "path": ["search", "repositories"],
          "query": [
            { "key": "q", "value": "topic:agent-memory" },
            { "key": "sort", "value": "stars" },
            { "key": "order", "value": "desc" },
            { "key": "per_page", "value": "{{per_page}}" }
          ]
        }
      }
    },
